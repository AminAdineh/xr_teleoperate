# Copy this file to ".env" (no name before the dot) and fill in your real IPs.
# Docker Compose reads .env automatically when you run `docker compose up/build`.

# Your Unitree robot's LAN IP.
# Find it on the robot's display or in the Unitree app. Default is often 192.168.123.161.
ROBOT_IP=192.168.123.161

# Your WINDOWS PC's LAN IP — the XR headset connects here over HTTPS.
# Run `ipconfig` in PowerShell and use your Wi-Fi/Ethernet IPv4 address.
HOST_IP=192.168.1.50

# The PC running teleimager with the cameras (often the robot's onboard PC or a host PC).
IMG_SERVER_IP=192.168.123.164
